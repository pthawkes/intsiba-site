  <DataSets>
    <DataSet Name="ClientCodeLiabilityTotals">
      <Query>
        <DataSourceName>selectDB</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@AsAtDate">
            <Value>=Parameters!AsAtDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT
    AsAtDate,
    ClientId,
    ClientName,
    ClientIdentifier,
    CatalogueName,
    NetSuiteID,
    TotalAmount,
    TotalChargesAmount,
    TotalDiscountAmount,
    TotalTaxAmount,
    TotalLive,
    TotalRedeemed,
    TotalExpired,
    TotalCancelled,
    TotalInactive,
    TotalEcodeValue
FROM dbo.fnClientCodeLiabilityTotalsAsAt(@AsAtDate)</CommandText>
      </Query>
      <Fields>
        <Field Name="AsAtDate">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>AsAtDate</DataField>
        </Field>
        <Field Name="ClientId">
